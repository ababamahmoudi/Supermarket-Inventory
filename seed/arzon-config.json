  "terminology": {
    "nav_invoices": "Invoices",
    "nav_invoices_subtitle": "Deliveries and supplier invoices",
    "nav_returns": "Returns",
    "nav_returns_subtitle": "Supplier returns and credits",
    "role_floor_worker": "Floor Worker",
    "category_kitchenware": "Kitchenware",
    "category_grocery_taxable": "Grocery (Taxable)",
    "product_code": "Product Code",
    "selling_price": "Selling Price",
    "date_tracking": "Date tracking"
  }
